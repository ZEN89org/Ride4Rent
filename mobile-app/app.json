{
  "expo": {
    "name": "Ride4Rent",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/applogo.png",
    "scheme": "ride4rent",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zensysorg.ride4rent",
      "icon": "./assets/images/applogo.png"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.zensysorg.ride4rent",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "icon": "./assets/images/applogo.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/applogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FEC103"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain",
          "android": {
            "drawable": {
              "icon": "./assets/images/launch-empty.xml"
            },
            "dark": {
              "backgroundColor": "#FFFFFF"
            }
          },
          "ios": {
            "backgroundColor": "#FFFFFF",
            "dark": {
              "backgroundColor": "#FFFFFF"
            }
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow Ride4Rent to use your microphone for calls.",
          "cameraPermission": "Allow Ride4Rent to use your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ride4Rent to share your location with your rental operator during an active trip.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c1a07d4-cf5d-41a0-ac0e-a6d133d781a1"
      }
    }
  }
}
